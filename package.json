{
  "name": "english-record",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Grabadora móvil con transcripción en vivo en el dispositivo (Whisper + Silero VAD).",
  "scripts": {
    "predev": "node scripts/prepare-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/prepare-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "icons": "python3 scripts/generate-icons.py",
    "tauri": "LIBCLANG_PATH=${LIBCLANG_PATH:-$PWD/.tools/libclang-lib} tauri",
    "dev:tauri": "LIBCLANG_PATH=${LIBCLANG_PATH:-$PWD/.tools/libclang-lib} tauri dev",
    "build:tauri": "LIBCLANG_PATH=${LIBCLANG_PATH:-$PWD/.tools/libclang-lib} tauri build",
    "build:web": "tsc --noEmit && vite build",
    "dev:web": "vite",
    "predev:tauri": "node scripts/prepare-tauri-models.mjs",
    "prebuild:tauri": "node scripts/prepare-tauri-models.mjs && npm run build"
  },
  "dependencies": {
    "@fugood/node-whisper-wasm": "1.2.0-rc.2",
    "onnxruntime-web": "1.22.0",
    "@tauri-apps/api": "^2.12.5"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "@tauri-apps/cli": "^2.12.6"
  },
  "engines": {
    "node": ">=20.19"
  }
}
